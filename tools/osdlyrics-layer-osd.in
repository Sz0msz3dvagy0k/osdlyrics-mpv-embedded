#!@PYTHON@
# -*- coding: utf-8 -*-

import base64
import os
import sys

import gi

try:
    gi.require_version("Gdk", "3.0")
    gi.require_version("Gtk", "3.0")
    gi.require_version("GtkLayerShell", "0.1")
    gi.require_version("Pango", "1.0")
except Exception as e:
    sys.stderr.write("osdlyrics-layer-osd: incompatible GI environment: %s\n" % e)
    sys.exit(1)

from gi.repository import Gdk, GLib, Gtk, GtkLayerShell, Pango


class LayerOSD:
    def __init__(self):
        self.window = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        self.window.set_decorated(False)
        self.window.set_resizable(False)
        self.window.set_title("OSD Lyrics")
        self.window.set_accept_focus(False)
        self.window.set_focus_on_map(False)
        self.window.connect("destroy", Gtk.main_quit)
        self.window.connect("delete-event", self._ignore_close)

        GtkLayerShell.init_for_window(self.window)
        GtkLayerShell.set_namespace(self.window, "osdlyrics")
        GtkLayerShell.set_layer(self.window, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_keyboard_mode(self.window, GtkLayerShell.KeyboardMode.NONE)
        for edge in (GtkLayerShell.Edge.LEFT,
                     GtkLayerShell.Edge.RIGHT,
                     GtkLayerShell.Edge.BOTTOM):
            GtkLayerShell.set_anchor(self.window, edge, True)
        GtkLayerShell.set_margin(self.window, GtkLayerShell.Edge.LEFT, 64)
        GtkLayerShell.set_margin(self.window, GtkLayerShell.Edge.RIGHT, 64)
        GtkLayerShell.set_margin(self.window, GtkLayerShell.Edge.BOTTOM, 36)

        self.window.set_app_paintable(True)
        self.window.set_visual(self._rgba_visual())

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.set_halign(Gtk.Align.CENTER)
        root.set_valign(Gtk.Align.END)
        root.set_size_request(960, -1)
        root.set_margin_top(8)
        root.set_margin_bottom(8)
        root.set_margin_start(16)
        root.set_margin_end(16)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.get_style_context().add_class("osd-card")
        card.set_size_request(880, -1)
        card.set_margin_top(8)
        card.set_margin_bottom(8)
        card.set_margin_start(8)
        card.set_margin_end(8)

        self.current_label = Gtk.Label()
        self.current_label.set_justify(Gtk.Justification.CENTER)
        self.current_label.set_halign(Gtk.Align.CENTER)
        self.current_label.set_line_wrap(False)
        self.current_label.set_ellipsize(Pango.EllipsizeMode.END)
        self.current_label.set_max_width_chars(60)
        self.current_label.get_style_context().add_class("current-line")

        self.progress = Gtk.ProgressBar()
        self.progress.set_show_text(False)
        self.progress.set_fraction(0.0)
        self.progress.get_style_context().add_class("lyric-progress")

        self.next_label = Gtk.Label()
        self.next_label.set_justify(Gtk.Justification.CENTER)
        self.next_label.set_halign(Gtk.Align.CENTER)
        self.next_label.set_line_wrap(False)
        self.next_label.set_ellipsize(Pango.EllipsizeMode.END)
        self.next_label.set_max_width_chars(60)
        self.next_label.get_style_context().add_class("next-line")

        card.pack_start(self.current_label, False, False, 0)
        card.pack_start(self.progress, False, False, 10)
        card.pack_start(self.next_label, False, False, 8)
        root.pack_end(card, False, False, 0)
        self.window.add(root)

        self._install_css()
        self._buffer = ""
        GLib.io_add_watch(sys.stdin.fileno(), GLib.IO_IN | GLib.IO_HUP, self._stdin_ready)

    def _ignore_close(self, *args):
        return True

    def _rgba_visual(self):
        screen = Gdk.Screen.get_default()
        if screen is None:
            return None
        return screen.get_rgba_visual()

    def _install_css(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(
            b"""
            window {
              background-color: transparent;
            }
            .osd-card {
              background-color: rgba(10, 10, 10, 0.68);
              border-radius: 26px;
              padding: 22px 28px 20px 28px;
            }
            .current-line {
              color: #f5f5f5;
              font-size: 24px;
              font-weight: 700;
            }
            .next-line {
              color: rgba(245, 245, 245, 0.72);
              font-size: 17px;
            }
            .lyric-progress trough {
              min-height: 6px;
              border-radius: 999px;
              background-color: rgba(255, 255, 255, 0.12);
            }
            .lyric-progress progress {
              border-radius: 999px;
              background-color: #f3c969;
            }
            """
        )
        screen = Gdk.Screen.get_default()
        if screen is not None:
            Gtk.StyleContext.add_provider_for_screen(
                screen,
                provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )

    def _decode_field(self, value):
        if not value:
            return ""
        return base64.b64decode(value.encode("ascii")).decode("utf-8", "replace")

    def _apply_state(self, visible, percentage, current, upcoming):
        if not visible or (not current and not upcoming):
            self.window.hide()
            return

        self.current_label.set_text(current)
        self.next_label.set_text(upcoming)
        self.next_label.set_visible(bool(upcoming))
        self.progress.set_fraction(max(0.0, min(1.0, percentage)))
        self.window.show_all()

    def _handle_line(self, line):
        parts = line.split("\t")
        if len(parts) != 5 or parts[0] != "STATE":
            return
        visible = parts[1] == "1"
        try:
            percentage = float(parts[2])
        except ValueError:
            percentage = 0.0
        current = self._decode_field(parts[3])
        upcoming = self._decode_field(parts[4])
        self._apply_state(visible, percentage, current, upcoming)

    def _stdin_ready(self, fd, condition):
        if condition & GLib.IO_HUP:
            Gtk.main_quit()
            return False
        data = os.read(fd, 4096)
        if not data:
            return True
        self._buffer += data.decode("utf-8", "replace")
        while "\n" in self._buffer:
            line, self._buffer = self._buffer.split("\n", 1)
            line = line.strip()
            if line:
                self._handle_line(line)
        return True


def main():
    initialized, _argv = Gtk.init_check(sys.argv)
    if not initialized:
        sys.stderr.write("osdlyrics-layer-osd: unable to initialize GTK display\n")
        return 1
    LayerOSD()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
